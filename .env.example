# Copy to .env (gitignored) and replace every change-me. Never commit .env.

# --- Postgres: docker compose `db` service ---
POSTGRES_USER=lantern
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lantern
# Host port for the dev database (5432 is often taken by a local Postgres install).
LANTERN_DB_PORT=5434

# --- Lantern ---
# SQLAlchemy async URL; must use the postgresql+asyncpg driver.
# Keep user/password/port in sync with the Postgres values above.
LANTERN_DATABASE_URL=postgresql+asyncpg://lantern:change-me@localhost:5434/lantern
